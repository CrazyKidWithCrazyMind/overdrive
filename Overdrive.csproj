<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Overdrive</RootNamespace>
    <AssemblyName>Overdrive</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Product>OVERDRIVE</Product>
    <AssemblyTitle>OVERDRIVE - Roblox Performance Engine</AssemblyTitle>
    <Description>Native Windows tuning suite for Roblox. Applies allowlisted FastFlags, system tweaks and cache maintenance, then launches the client.</Description>
    <Company>Overdrive</Company>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
